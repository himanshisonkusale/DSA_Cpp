class MinStack {
public:
    stack<int> st; 
    stack<int> Minst;

    MinStack() {
        
    }
    
    void push(int value) {
        st.push(value);
        if(Minst.empty() || value <= Minst.top()){
            Minst.push(value);
        }
    }
    
    void pop() {
        if(st.top() == Minst.top()){
            Minst.pop();
        }
        st.pop();
    }
    
    int top() {
        return st.top();
    }
    
    int getMin() {
        return Minst.top();
    }

};

