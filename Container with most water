class Solution {
public:
    int maxArea(vector<int>& height) {
        int left = 0;
        int right = height.size()-1;
        int area = 0;
    
        while(left<right){
            int width = abs(left - right);

            int currAREA = width * min(height[left], height[right]);
            area = max(area, currAREA );

            if(height[left] > height[right]){
                right --;
            }
            else{
                left++;
            }

        }
        return area;
    }
};
