class Solution {
public:
long long function(vector<int>&piles , int n, int guess){ // guess is our speed
    long long h = 0;
    for(int i=0;i<n;i++){
        h = h+ piles[i]/guess;
        if(piles[i] % guess != 0){
            h ++;
        }
    }
    return h;
}
    int minEatingSpeed(vector<int>& piles, int h) {
        int n =piles.size();
        int res = -1;
        int low = 1;
        int high = *max_element(piles.begin(), piles.end());
        while(low<=high){
            int guess = (low+high)/2;
            long long hour = function(piles,n,guess);
            if(hour > h){
                low = guess +1;
            }
            else{
                res = guess ;
                high = guess-1;
            }

        }
        return res;
    }
};
