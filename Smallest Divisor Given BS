class Solution {
public:
bool divisor(vector<int>&nums,int threshold, int guess){
    int sum = 0;
    for (int i = 0; i < nums.size(); i++) {
            sum += ceil((double)nums[i] / guess);
        }

    if(sum<= threshold) {
        return true;
    }
    else{
        return false;
    }
}
    int smallestDivisor(vector<int>& nums, int threshold) {
        int n = nums.size();
        int res = -1;
        int low = 1;
        int high = *max_element(nums.begin(), nums.end());
        while(low<=high){
            int guess = (low+high)/2;

            if(divisor(nums,threshold,guess)){
                res = guess;
                high = guess-1;
                

            }
            else{
                low = guess +1;
            }
        }
        return res;
    
    }
};
