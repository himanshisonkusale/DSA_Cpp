class Solution {
public:

    void fun(vector<int>& nums, int n, int idx,
             vector<int>& tmp, vector<vector<int>>& ans) {

        if (idx == n) {
            ans.push_back(tmp);
            return;
        }

        
        fun(nums, n, idx + 1, tmp, ans);
        tmp.push_back(nums[idx]);
        fun(nums, n, idx + 1, tmp, ans);
        tmp.pop_back();
    }

    vector<vector<int>> subsets(vector<int>& nums) {

        int n = nums.size();
        vector<vector<int>> ans;
        vector<int> tmp;

        fun(nums, n, 0, tmp, ans);

        return ans;
    }
};
