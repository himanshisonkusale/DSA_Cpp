class Solution {
public:
int distfromorigin(vector<vector<int>>&points , int i){
    int x1 = points[i][0];
    int x2 = points[i][1];
    return x1*x1+x2*x2;
}

    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {
        priority_queue<pair<int,int>> pq;

        for(int i = 0; i < points.size(); i++){

            int distance = distfromorigin(points , i);
            pair<int,int> curr = {distance , i};

            if(pq.size() < k) {
                pq.push(curr);
                continue;
            }

            if(pq.top().first < curr.first){
                continue;
            }
            else{
                pq.pop();
                pq.push(curr);
            }

        }

        vector<vector<int>> ans;

        while(!pq.empty()){
            ans.push_back(points[pq.top().second]);
            pq.pop();
        }

        return ans;
    }
};
