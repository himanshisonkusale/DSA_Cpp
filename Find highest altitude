brute force using array 
class Solution {
public:
    int largestAltitude(vector<int>& gain) {
        int n = gain.size();
        vector<int> a(n+1);

        a[0] = 0;
        int greatest = 0;

        for(int i=1; i<n+1; i++){
            a[i] = a[i-1] + gain[i-1];
            if(a[i] > greatest){
                greatest = a[i];
            }
        
        }

        return greatest;       
    }
};

// optimized using varaibles 

class Solution {
public:
    int largestAltitude(vector<int>& gain) {

        int currentAlt = 0;
        int maxAlt = 0;

        for (int i = 0; i < gain.size(); i++) {
            currentAlt += gain[i];
            maxAlt = max(maxAlt, currentAlt);
        }

        return maxAlt;
    }
};



