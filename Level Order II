class Solution {
public:
    vector<vector<int>> levelOrderBottom(TreeNode* root) {

    vector<vector<int>> ans;
    if(root == NULL)
        return ans;

    queue<TreeNode*> q;
    q.push(root);

    while(!q.empty()) {

        int lvlsize = q.size();
        vector<int> tmp;
        while(lvlsize--) {
            TreeNode* t = q.front();
            q.pop();

            tmp.push_back(t->val);

            if(t->left)
                q.push(t->left);

            if(t->right)
                q.push(t->right);
        }

        ans.push_back(tmp);
    }
    reverse(ans.begin(), ans.end());
    return ans;
}
};
