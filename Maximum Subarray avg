class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int low =0;
        int sum = 0;
        for(int i=0; i<k; i++){
            sum+= nums[i];
        }
        int maxSum = sum;
        for(int high = k; high < nums.size(); high++){
            sum+= nums[high];
            sum-= nums[low];
            low++; // shrink
            maxSum = max(maxSum,sum);
        }
        return (double)maxSum/k;
    }
};
