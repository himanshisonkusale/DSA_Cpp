class Solution {
public:
bool fun(vector<int>&nums, int n, int i, vector<vector<int>>&dp, int sum){
    if(i == n) return false;
    if(sum == 0) return true;
    if(dp[i][sum] != -1){
        return dp[i][sum];
    }
    if(nums[i] > sum) return dp[i][sum]=fun(nums,n,i+1,dp,sum);

    bool yes = fun(nums,n,i+1,dp,sum - nums[i]);
    bool no = fun(nums,n,i+1,dp,sum);

    return dp[i][sum] = yes || no;
}
    bool canPartition(vector<int>& nums) {
        
        int n = nums.size();
        int sum = 0;
        for(int i=0 ; i<n; i++){
            sum += nums[i];
        }
        if(sum%2 != 0){
            return false;
        }
        sum = sum/2;

        vector<vector<int>>dp(n);
        for(int i=0; i<n; i++){
            vector<int> t(sum+1, -1);
            dp[i] = t;
        }

        return fun(nums,n,0,dp,sum);

    }
};
