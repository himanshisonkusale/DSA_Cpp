class Solution {
public:
int countnumber(int m , int n , int guess){
    int count = 0;
    for(int i =1; i<=m; i++){
        count += min(guess/i, n);

    }

    return count;
}
    int findKthNumber(int m, int n, int k) {
        int res = -1;
        int low = 1;
        int high = m*n;
        while(low<=high){
            int guess = (low+high)/2;
            int ans = countnumber(m,n,guess);
            if(ans < k){
                low = guess +1;
            }
            else{
                res = guess;
                high = guess -1;
            }
        }
        return res;
    }
};
