class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
// optimized approach where we are using only one array ans to store the product 
// my approach - used 3 arrays prefix, suffix and ans to fir cal the left to right and right to left products and multiply to get ans array - TC - o(n)
        int n = nums.size();
        vector<int> ans(n);

        int product = 1;

        
        for (int i = 0; i < n; i++) {
            ans[i] = product;
            product *= nums[i];
        }

        int multi = 1;

        
        for (int j = n - 1; j >= 0; j--) {
    
            ans[j] = ans[j] * multi;
            multi *= nums[j]; // update again by adding another element 
        }

    
        return ans;
    }
};
