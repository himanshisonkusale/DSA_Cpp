class Solution {
public:
bool sum(vector<int>& nums, int k , int n, int guess){
    int split = 1;
    int arrsum = 0;
    for(int i =0; i<n; i++){
        if(arrsum + nums[i] <= guess){
            arrsum = arrsum + nums[i];
        }
        else{
            split ++;
            arrsum = nums[i];
            if(split > k){
                return false;
            }
        }
    }

    return true;

}
    int splitArray(vector<int>& nums, int k) {
        int n = nums.size();
        int low = 0;
        int high = 0;
        int res = -1;
        for(int i =0;i<n;i++){
            low = max(low , nums[i]);
            high+= nums[i];

        }
        while(low<=high){
            int guess = (low + high)/2;
            if(sum(nums , k , n , guess)){
                res = guess;
                high = guess -1;
            }
            else{
                low = guess + 1;
            }
        }
        return res;
    }
};
