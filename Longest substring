class Solution {
public:
    int characterReplacement(string s, int k) {
        int low = 0;
        int ans = 0;
        int maxFreq = 0;
        unordered_map<char, int> freq;
        for (int high = 0; high < s.size(); high++) {
            freq[s[high]]++;

            maxFreq = max(maxFreq, freq[s[high]]);

            while ((high - low + 1) - maxFreq > k) {
                freq[s[low]]--;
                low++;
            }

            ans = max(ans, high - low + 1);
        }

        return ans;
    }
};
