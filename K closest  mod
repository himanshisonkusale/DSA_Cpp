class Solution {
public:
    int distance(vector<int>& arr, int x, int i){
        int mod = abs(arr[i] - x);
        return mod;
    }

    vector<int> findClosestElements(vector<int>& arr, int k, int x) {

        priority_queue<pair<int,int>> pq;

        for(int i = 0; i < arr.size(); i++){
            int dist = distance(arr, x, i);
            pair<int,int> curr = {dist, arr[i]};

            if(pq.size() < k){
                pq.push(curr);
                continue;
            }
            if(curr.first < pq.top().first){
                pq.pop();
                pq.push(curr);
            }
            else if(curr.first == pq.top().first && curr.second < pq.top().second){
                pq.pop();
                pq.push(curr);
            }
        }

        vector<int> ans;

        while(!pq.empty()){
            ans.push_back(pq.top().second);
            pq.pop();
        }

        sort(ans.begin(), ans.end());

        return ans;
    }
};
