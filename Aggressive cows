class Solution {
  public:
  bool function(vector<int>&stalls, int n, int k, int guess){
      int cows = 1; //intially 
      int posprev = stalls[0];
      for(int i=0; i<n; i++){
          int dist = stalls[i] - posprev;
          if(dist < guess) continue;
          else{
              cows++;
              posprev = stalls[i];
          }
      }
      if(cows >= k) return true;
      else{
          return false;
      }
  }
    int aggressiveCows(vector<int> &stalls, int k) {
        int res = -1;
        int n = stalls.size();
        sort(stalls.begin(), stalls.end());  
        int low = 1;
        int high = stalls[n-1] - stalls[0];
        while(low<=high){
            int guess = (low+high)/2;
            
            if(function(stalls,n,k,guess)){
                res = guess;
                low = guess +1;
            }
            else{
                high = guess -1;
            }
        }
        
        
        
        return res;
        
    
}       
    
};
