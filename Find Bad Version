// The API isBadVersion is defined for you.
// bool isBadVersion(int version);

class Solution {
public:
    int firstBadVersion(int n) {
        int low = 1;
        int high = n;
        int res = -1;
        while(low <= high){
            int guess = low + (high - low) / 2;
            if(isBadVersion(guess) == true){
                res = guess;
                high = guess -1;
            }
            else{
                low = guess +1;
            }
        }
        return res;
    }
};
